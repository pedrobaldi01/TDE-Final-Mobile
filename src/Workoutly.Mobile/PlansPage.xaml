<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Workoutly.Mobile.ViewModels" x:DataType="vm:PlansViewModel" xmlns:services="clr-namespace:Workoutly.Mobile.Models" x:Class="Workoutly.Mobile.PlansPage" Title="Fichas">
    <Grid Padding="20,16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <VerticalStackLayout Spacing="4">
            <Label Text="ROTINA SEMANAL" Style="{StaticResource Eyebrow}" />
            <Label x:Name="Heading" Text="Minhas fichas" Style="{StaticResource PageTitle}" />
            <Entry Text="{Binding Query, Mode=TwoWay}" Placeholder="Pesquisar pelo nome" ClearButtonVisibility="WhileEditing" />
            <HorizontalStackLayout RadioButtonGroup.GroupName="Favorites" RadioButtonGroup.SelectedValue="{Binding OnlyFavorites, Mode=TwoWay}">
                <RadioButton Content="Todas" AutomationId="filter_all"><RadioButton.Value><x:Boolean>False</x:Boolean></RadioButton.Value></RadioButton>
                <RadioButton Content="Só favoritas" AutomationId="filter_favorites"><RadioButton.Value><x:Boolean>True</x:Boolean></RadioButton.Value></RadioButton>
            </HorizontalStackLayout>
            <Label Text="Salvas neste aparelho. Favoritas aparecem primeiro." Style="{StaticResource SecondaryText}" />
        </VerticalStackLayout>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button x:Name="CreateButton" Text="Nova ficha" Clicked="OnCreate" AutomationId="plan_create" />
            <Button Grid.Column="1" x:Name="RefreshButton" Text="Atualizar" Clicked="OnRefresh" Style="{StaticResource TextButton}" />
        </Grid>
        <VerticalStackLayout Grid.Row="2" Spacing="6">
            <ActivityIndicator x:Name="Loading" IsVisible="False" />
            <Label x:Name="ListStatus" Style="{StaticResource SecondaryText}" />
            <Label x:Name="ErrorText" TextColor="{StaticResource Error}" IsVisible="False" AutomationId="plans_error" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="3" x:Name="PlansList" ItemsSource="{Binding Visible}" SelectionMode="None" AutomationId="plans_list">
            <CollectionView.EmptyView><Label Text="Nenhum registro encontrado." Style="{StaticResource SecondaryText}" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:PlanItem">
                    <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="★ FAVORITO" IsVisible="{Binding Favorite}" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding Name}" FontFamily="InterSemiBold" FontSize="19" />
                            <Label Text="{Binding Notes}" Style="{StaticResource SecondaryText}" MaxLines="3" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Summary}" Style="{StaticResource SecondaryText}" FontSize="12" />
                            <Button Text="Abrir ficha" CommandParameter="{Binding .}" Clicked="OnOpen" Style="{StaticResource SecondaryButton}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border x:Name="Snackbar" Grid.RowSpan="4" VerticalOptions="End" Margin="8" Padding="16,12" BackgroundColor="{StaticResource Accent}" IsVisible="False" InputTransparent="True">
            <Label x:Name="SnackbarText" TextColor="Black" FontFamily="InterSemiBold" />
        </Border>
    </Grid>
</ContentPage>