<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Workoutly.Mobile.MainPage" Title="Início">
    <ScrollView><VerticalStackLayout Padding="24" Spacing="24" MaximumWidthRequest="600">
        <Image Source="workoutly_logo.png" HeightRequest="60" HorizontalOptions="Start" />
        <Label Text="SEU PLANEJAMENTO" Style="{StaticResource Eyebrow}" />
        <Label Text="Sua rotina,
no seu aparelho." Style="{StaticResource PageTitle}" />
        <Label Text="Organize suas fichas com exercícios, séries, repetições e cargas de referência." Style="{StaticResource SecondaryText}" />
        <Border Style="{StaticResource SurfaceCard}"><VerticalStackLayout Spacing="14">
            <Label Text="Minhas fichas" FontFamily="InterSemiBold" FontSize="20" />
            <Label Text="Crie, pesquise e edite suas fichas. Marque as favoritas para encontrá-las facilmente." Style="{StaticResource SecondaryText}" />
            <Button Text="Abrir minhas fichas" Clicked="OnPlans" AutomationId="home_plans" />
        </VerticalStackLayout></Border>
        <Label Text="Tudo fica salvo neste aparelho em SQLite. Você pode usar o app sem conexão." Style="{StaticResource SecondaryText}" />
    </VerticalStackLayout></ScrollView>
</ContentPage>
